#!/bin/sh
# Refuses a push unless hack/check.sh passes. That script is the gate; do not
# enumerate its steps here, because the last time this did it named go vet and a
# docs typecheck, neither of which the script ran, and nobody noticed for a while.
# Enable once per clone: git config core.hooksPath .githooks
exec bash "$(git rev-parse --show-toplevel)/hack/check.sh"
