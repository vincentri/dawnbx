# local tool state (browser tokens, logs, personal settings)
.claude/
.gstack/
.serena/
.harness-eval/
.omp/
.DS_Store

# Per-task git worktrees, which live inside this checkout (AGENTS.md section 1).
# A worktree is a full second checkout with its own node_modules, so it must never
# be tracked, and a task that ends deletes its own directory anyway.
.worktree/

# Spec Kit per-machine bookkeeping. The constitution, templates, scripts and
# workflows under .specify/ are tracked; these three churn on every refresh and
# say which AI integration this checkout happens to use.
.specify/init-options.json
.specify/integration.json
.specify/integrations/

# build output
/dawnbx
/dawnbx-server
*.test
dist/
*.tsbuildinfo
node_modules/
__pycache__/
.pytest_cache/
*.egg-info/
.venv/
coverage/
.coverage
htmlcov/
.ruff_cache